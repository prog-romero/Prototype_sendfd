# syntax=docker/dockerfile:1
#
# Dockerfile.fullproxy — image fonction IoT BeFaaS, mode PROTOTYPE (full-proxy).
#
# Le of-watchdog est compilé avec CGO + wolfSSL + libtlspeek : il fait TOUTE la
# plomberie de connexion (peek TLS, routage propriétaire, relai, keep-alive,
# trame HTTP, read/write wolfSSL, ré-export de l'état TLS) pour HTTP ET HTTPS,
# puis reverse-proxy la requête métier vers le serveur Node (template
# node10-express-service + fonction BeFaaS) sur 127.0.0.1:8085.
#
# Le serveur Node ne contient AUCUN code sendfd/TLS : uniquement la logique
# métier BeFaaS. Une seule image par fonction sert les évals HTTP ET HTTPS
# (le bridge dispatche selon le magic de la connexion migrée).
#
# La fonction à embarquer est choisie au build via FUNCTION_NAME :
#   docker buildx build --platform linux/arm64 \
#     --build-arg FUNCTION_NAME=emergencydetection \
#     -f benchmarks/micro/micro-bench3-keepalive-https-integration/macro-befaas-iot/Dockerfile.fullproxy \
#     -t romerosdd/iot-fullproxy-emergencydetection:latest --push .
#
# Le contexte de build DOIT être la racine du dépôt. Build sous émulation arm64.

ARG FUNCTION_NAME=emergencydetection

# ── Stage 1 : build wolfSSL (arm64 natif) ─────────────────────────────────────
FROM golang:1.24-bookworm AS wolfssl-build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential autoconf automake libtool ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY wolfssl/ /wolfssl-src/
WORKDIR /wolfssl-src
RUN ./autogen.sh && \
    ./configure --prefix=/usr/local \
        --enable-tls13 --enable-opensslextra --enable-atomicuser \
        --enable-sessionexport --enable-session-ticket --enable-keylog-export \
        --enable-aesgcm --enable-chacha --enable-hkdf --enable-aescbc \
        --enable-shared --enable-static && \
    make -j"$(nproc)" && make install && ldconfig

# ── Stage 2 : build libtlspeek (arm64 natif) ──────────────────────────────────
FROM wolfssl-build AS tlspeek-build
RUN apt-get update && apt-get install -y --no-install-recommends cmake \
 && rm -rf /var/lib/apt/lists/*
COPY libtlspeek /libtlspeek-src
WORKDIR /libtlspeek-src
RUN rm -rf build && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release \
        -DWOLFSSL_INCLUDE=/usr/local/include \
        -DWOLFSSL_LIB=/usr/local/lib/libwolfssl.so && \
    make -j"$(nproc)" tlspeek && \
    install -d /usr/local/include/tlspeek && \
    cp -f ../lib/*.h ../common/*.h /usr/local/include/tlspeek/ && \
    cp -f libtlspeek.a /usr/local/lib/libtlspeek.a && ldconfig

# ── Stage 3 : build du watchdog CGO (toute la plomberie) ──────────────────────
# of-watchdog/go.mod requiert Go >= 1.26 -> golang:latest. On y copie les
# artefacts wolfSSL + libtlspeek (headers + libs) construits ci-dessus.
FROM golang:latest AS watchdog-build
COPY --from=tlspeek-build /usr/local/include /usr/local/include
COPY --from=tlspeek-build /usr/local/lib     /usr/local/lib
RUN ldconfig
WORKDIR /go/src/github.com/openfaas/of-watchdog
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/of-watchdog/ .
RUN rm -rf vendor && go mod download
RUN mkdir -p /out && CGO_ENABLED=1 go build -tags wolfssl \
    -ldflags "-s -w" -o /out/fwatchdog .

# ── Stage 4 : runtime (trixie pour GLIBC du watchdog CGO + Node) ──────────────
# Le watchdog CGO est lié dynamiquement à la glibc de golang:latest (trixie,
# glibc >= 2.38). On part donc de debian:trixie-slim et on y installe Node via
# le tarball officiel (comme le Dockerfile du framework BeFaaS le fait pour node).
FROM debian:trixie-slim AS runtime
ARG FUNCTION_NAME
ARG NODE_VERSION=v18.20.4

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Node arm64 (architecture du Pi).
RUN curl -fSLO "https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-arm64.tar.xz" \
 && tar xJf "node-${NODE_VERSION}-linux-arm64.tar.xz" -C /usr/local --strip-components=1 --no-same-owner \
 && rm "node-${NODE_VERSION}-linux-arm64.tar.xz" \
 && node --version && npm --version

# libwolfssl.so partagée (le watchdog CGO en dépend au runtime).
COPY --from=wolfssl-build /usr/local/lib/libwolfssl.so* /usr/local/lib/
RUN ldconfig

COPY --from=watchdog-build /out/fwatchdog /usr/bin/fwatchdog

# --- Couche hôte (template node10-express-service) : /home/app -----------------
WORKDIR /home/app
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/macro-befaas-iot/template/package.json ./package.json
RUN npm install --omit=dev
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/macro-befaas-iot/template/index.js ./index.js

# --- Couche fonction : /home/app/function -------------------------------------
WORKDIR /home/app/function
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/macro-befaas-iot/function-package.json ./package.json
RUN npm install --omit=dev
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/macro-befaas-iot/template/handler.js ./handler.js
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/macro-befaas-iot/functions/${FUNCTION_NAME}/index.js ./index.js
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/macro-befaas-iot/experiment.json ./experiment.json
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/macro-befaas-iot/experiment.json /home/app/experiment.json

WORKDIR /home/app

# fprocess = le serveur Node ; le watchdog full-proxy lui transmet chaque
# requête métier migrée sur 127.0.0.1:8085.
ENV fprocess="node index.js"
ENV mode=http
ENV http_upstream_url="http://127.0.0.1:8085"
ENV http_port=8085

# Active le serveur de migration FD + le driver full-proxy dans le watchdog.
ENV sendfd_enable=1
ENV sendfd_full_proxy=1
ENV sendfd_socket_dir=/run/tlsmigrate
ENV SENDFD_SOCKET_DIR=/run/tlsmigrate
# Identité de la fonction (route + nom du socket nommé). Surchargé par le YAML.
ENV HTTPMIGRATE_KA_FUNCTION_NAME=emergencydetection

# Chemin OpenFaaS de @befaas/lib + identité.
ENV IS_OPENFAAS=1
ENV BEFAAS_FN_NAME=emergencydetection
# Endpoint inter-fonctions (ctx.call).
# ATTENTION : ce défaut est purement indicatif. La valeur RÉELLE est imposée au
# déploiement par deploy-all.sh selon le MODE, et elle est IDENTIQUE pour vanilla
# et proto (http://…:8080 en mode http, https://…:8443 en mode https) -> la
# comparaison est équitable (même schéma client + inter-fonctions dans les 2 modes).
ENV OPENFAAS_ENDPOINT="https://192.168.2.2:8443/function"
# Cert auto-signé du gateway : node-fetch doit l'accepter pour l'éval HTTPS.
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
# Backend d'état Redis. Surchargé par le YAML.
ENV REDIS_ENDPOINT="redis://10.62.0.1:6379"

# Certificats pour le chemin HTTPS (même convention que les images C-worker).
ENV HTTPS_TLS_CERT=/var/openfaas/secrets/server-crt
ENV HTTPS_TLS_KEY=/var/openfaas/secrets/server-key

CMD ["/usr/bin/fwatchdog"]
