# syntax=docker/dockerfile:1
#
# Dockerfile.vanilla — fonction "sum" en JS (style BeFaaS), mode VANILLA.
# of-watchdog vanilla (CGO_ENABLED=0, sendfd_enable=0) qui reverse-proxy vers le
# serveur Node/Express (server.js) sur 127.0.0.1:8085. Pas de TLS, pas de sendfd.
#
#   docker buildx build --platform linux/arm64 \
#     -f benchmarks/micro/micro-bench3-keepalive-https-integration/proto_function/sum-js/Dockerfile.vanilla \
#     -t romerosdd/sum-js-vanilla:latest --push .
#
# Le contexte de build DOIT être la RACINE du dépôt.

# ── Stage 1 : build du watchdog vanilla (sans CGO) ───────────────────────────
FROM golang:latest AS watchdog-build
WORKDIR /go/src/github.com/openfaas/of-watchdog
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/of-watchdog/ .
RUN rm -rf vendor && go mod download
RUN mkdir -p /out && CGO_ENABLED=0 GOOS=linux \
    go build -ldflags "-s -w" -o /out/fwatchdog .

# ── Stage 2 : runtime Node ───────────────────────────────────────────────────
FROM node:18-bullseye-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=watchdog-build /out/fwatchdog /usr/bin/fwatchdog

WORKDIR /home/app
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/proto_function/sum-js/package.json ./package.json
RUN npm install --omit=dev
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/proto_function/sum-js/server.js ./server.js

ENV fprocess="node server.js"
ENV mode=http
ENV http_upstream_url="http://127.0.0.1:8085"
ENV http_port=8085
ENV sendfd_enable=0

CMD ["/usr/bin/fwatchdog"]
