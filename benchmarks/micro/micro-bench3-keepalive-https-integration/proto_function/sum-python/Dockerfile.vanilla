# syntax=docker/dockerfile:1
#
# Dockerfile.vanilla — fonction "sum" en PYTHON (style SeBS), mode VANILLA.
# of-watchdog vanilla (CGO_ENABLED=0, sendfd_enable=0) qui reverse-proxy vers
# l'hôte Python (gunicorn + Flask) sur 127.0.0.1:8085. Pas de TLS, pas de sendfd.
#
#   docker buildx build --platform linux/arm64 \
#     -f benchmarks/micro/micro-bench3-keepalive-https-integration/proto_function/sum-python/Dockerfile.vanilla \
#     -t romerosdd/sum-python-vanilla:latest --push .
#
# Le contexte de build DOIT être la RACINE du dépôt.

# ── Stage 1 : build du watchdog vanilla (sans CGO) ───────────────────────────
FROM golang:latest AS watchdog-build
WORKDIR /go/src/github.com/openfaas/of-watchdog
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/of-watchdog/ .
RUN rm -rf vendor && go mod download
RUN mkdir -p /out && CGO_ENABLED=0 GOOS=linux \
    go build -ldflags "-s -w" -o /out/fwatchdog .

# ── Stage 2 : runtime Python ─────────────────────────────────────────────────
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 python3-pip \
 && rm -rf /var/lib/apt/lists/*

COPY --from=watchdog-build /out/fwatchdog /usr/bin/fwatchdog

WORKDIR /home/app
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/proto_function/sum-python/requirements.txt ./requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/proto_function/sum-python/server.py ./server.py
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/proto_function/sum-python/function.py ./function.py
COPY benchmarks/micro/micro-bench3-keepalive-https-integration/proto_function/sum-python/start.sh ./start.sh
RUN chmod +x ./start.sh

ENV GUNICORN_WORKERS=4
ENV fprocess="/home/app/start.sh"
ENV mode=http
ENV http_upstream_url="http://127.0.0.1:8085"
ENV http_port=8085
ENV sendfd_enable=0

CMD ["/usr/bin/fwatchdog"]
