        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#0072B2;strokeWidth=2;" edge="1" source="s1_client" target="s1_gw" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 2 — Keylog callback -->
