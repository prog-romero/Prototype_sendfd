        <!-- sub-step A -->
        <mxCell id="sub_a" value="① recv(MSG_PEEK) — buffer intact" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
