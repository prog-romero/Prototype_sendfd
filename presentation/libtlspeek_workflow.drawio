          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- sub-step B -->
        <mxCell id="sub_b" value="② Parse TLS record header (5 bytes)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="520" width="260" height="44" as="geometry"/>
