        <!-- Worker: restore -->
        <mxCell id="s9_restore" value="tlspeek_restore() — wolfSSL_tls_import()" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#D55E00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="305" width="310" height="44" as="geometry"/>
